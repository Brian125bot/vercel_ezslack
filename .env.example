# ── Required ──────────────────────────────────────────────────────────────

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SLACK_BOT_TOKEN: xoxb- token for posting messages and Block Kit approvals.
SLACK_BOT_TOKEN="xoxb-myslackbottoken"

# SLACK_SIGNING_SECRET: Slack app signing secret for request signature verification.
SLACK_SIGNING_SECRET="my_slack_signing_secret"

# WORKFLOW_INTERNAL_SECRET: Dedicated secret for authenticating internal requests to /api/workflows/agentRun.
# Required in production and on Vercel deployments. Generate a strong random string (e.g. openssl rand -hex 32).
WORKFLOW_INTERNAL_SECRET="workflow_internal_secret_placeholder"

# DASHBOARD_PASSWORD: HTTP Basic Auth password for the /api/* admin dashboard.
DASHBOARD_PASSWORD="my_dashboard_password"

# APP_URL: The public URL where this app is hosted.
# Used for self-referential webhook callbacks and workflow triggers.
APP_URL="https://your-app.vercel.app"


# ── Database (required — at least one connection source mandatory on all platforms) ──

# Vercel Postgres / Neon connection string.
# Append ?pgbouncer=true when using connection poolers (Neon, Supabase).
DATABASE_URL="postgresql://user:pass@host:port/db"

# SSL mode: set to "true" when DATABASE_URL requires SSL (default: false)
DATABASE_SSL="true"

# Pool config (optional)
DB_POOL_MAX="5"
DB_CONNECTION_TIMEOUT="10000"


# ── Agent tuning (optional) ──────────────────────────────────────────────

# Model override. Allowed: gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.0-flash, gemini-2.5-flash
# SELECTED_MODEL="gemini-3.1-flash-lite"

# Max concurrent direct-reply handlers (default: 5)
DIRECT_REPLY_CONCURRENCY="5"

# Wall-clock timeout per run in ms (default: 45000 — leaves 15s margin on Vercel Pro 60s)
RUN_TIMEOUT_MS="45000"

# Lease duration in seconds for worker claim (default: 120)
WORKER_LEASE_SECONDS="120"

# Gemini API timeout in ms (default: 30000)
GEMINI_TIMEOUT_MS="30000"


# ── Vercel KV (Upstash Redis) ────────────────────────────────────────────────
# Already read by src/server/redis.ts (dedup, thread cache) AND used by the
# global API rate limiter (express-rate-limit) when NODE_ENV=production.
# Vercel injects these automatically when KV is linked to the project.
# KV_REST_API_URL="https://<your-kv>.upstash.io"
# KV_REST_API_TOKEN="<kv-token>"
#
# Upstash-named fallbacks are also accepted (used when linking a standalone
# Upstash Redis rather than Vercel KV). Either pair satisfies isRedisConfigured().
# UPSTASH_REDIS_REST_URL="https://<your-upstash>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="<upstash-token>"


# ── Vercel deployment (optional) ──────────────────────────────────────────

# Vercel Automation Bypass Secret (for preview deployment protection bypass)
# VERCEL_AUTOMATION_BYPASS_SECRET="your-vercel-bypass-secret"

# Vercel Cron authentication secret — required on Vercel (set in Project Settings, not vercel.json).
# Vercel Cron sends Authorization: Bearer ${CRON_SECRET} when this is configured.
# CRON_SECRET="your-vercel-cron-secret"

# Disable automatic HTTP→HTTPS redirect (set to "1" to skip).
# Only checked in production; off by default.
# DISABLE_HTTPS_REDIRECT="1"


# ── Date/Time Context (optional) ──────────────────────────────────────────

# Include current date/time in agent context (default: true)
# AGENT_INCLUDE_DATETIME="true"

# Timezone for date/time display (default: UTC)
# AGENT_TIMEZONE="UTC"

# ── External Adapters (optional) ──────────────────────────────────────────

# GitHub Issues — https://github.com
# Optional. When set, enables the github.createIssue tool.
GITHUB_TOKEN=

# Email Webhook — Custom SMTP relay
# Optional. When set, enables the email.send tool.
EMAIL_WEBHOOK_URL=

# Web Search (Tavily) — https://app.tavily.com
# Optional. When set, enables the search.query tool (risk level: read, no approval required).
TAVILY_API_KEY=

# Web Fetch — no API key needed, uses native fetch
# Optional. Enables the web.fetch tool (risk level: read, no approval required).
# ENABLE_WEB_FETCH=true

# Sandbox (Vercel) — https://vercel.com/docs/sandbox
# Optional. When set (or running on Vercel), enables sandbox.* tools.
SANDBOX_API_KEY=
SANDBOX_TTL_MS=900000  # 15 minutes

# Multimodal attachments (images, PDFs, screenshots from Slack)
# Optional. Defaults shown below.
MAX_ATTACHMENT_BYTES=15728640
MAX_ATTACHMENTS_PER_MESSAGE=4
ATTACHMENT_DOWNLOAD_TIMEOUT_MS=20000

# ── Semantic Message Deduplication (optional) ──────────────────────────────

# Jaccard similarity threshold above which a message is suppressed (0.0-1.0, default: 0.75)
# SLACK_DEDUP_SIMILARITY_THRESHOLD="0.75"

# Number of recent messages per thread to compare against (default: 5)
# SLACK_DEDUP_WINDOW_SIZE="5"

# TTL in seconds for stored fingerprints (default: 300 - 5 minutes)
# SLACK_DEDUP_TTL_SECONDS="300"
